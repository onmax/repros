@@ -0,0 +1,5 @@
+import { joinURL } from "ufo";
+export function resolveAuthBaseURL(siteUrl, appBaseURL) {
+  const origin = new URL(siteUrl).origin;
+  return appBaseURL && appBaseURL !== "/" ? joinURL(origin, appBaseURL, "/api/auth") : origin;
+}
