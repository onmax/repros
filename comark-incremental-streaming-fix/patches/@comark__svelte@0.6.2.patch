diff --git a/dist/internal/parse.js b/dist/internal/parse.js
new file mode 100644
index 0000000000000000000000000000000000000000..7979ab8de491cdb54d7903e81ae5963d436d5574
--- /dev/null
+++ b/dist/internal/parse.js
@@ -0,0 +1,12 @@
+import { createMarkdownParser } from 'comark';
+// Serialize access to the parser's stream state without hiding plugin errors.
+export function createComponentParser(options) {
+    const parse = createMarkdownParser(options);
+    let pending = Promise.resolve();
+    return (...args) => {
+        const run = () => parse(...args);
+        const result = pending.then(run, run);
+        pending = result;
+        return result;
+    };
+}
